  <gui fullscreen='0'>
    <camera name='user_camera'>
      <!-- High top-down startup view centred on the env04 map
           (x in [-3,27], y in [-16,9]; centre ~(12,-3.5)).  pitch ~84 deg
           gives a near-vertical overlook while keeping the orbit controller
           away from the straight-down singularity.  The camera target is
           shifted 4 m along -X so the map sits 4 m higher in the frame. -->
      <pose>7 -3.5 45 0 1.4708 0</pose>
      <view_controller>orbit</view_controller>
      <projection_type>perspective</projection_type>
    </camera>
  </gui>
