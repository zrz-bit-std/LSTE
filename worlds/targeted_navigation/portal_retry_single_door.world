<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='lste_portal_retry_single_door'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.72 0.72 1</background>
      <shadows>true</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- Two 4 m x 4 m rooms share the x=0 wall. The two wall segments leave
         one 1.5 m doorway centered at y=0. There is no hidden teleport or
         semantic annotation: the opening must be discovered from the lidar. -->
    <model name='single_door_structure'>
      <static>true</static>
      <link name='walls'>
        <collision name='north_wall'>
          <pose>0 2 1.25 0 0 0</pose>
          <geometry><box><size>8 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='north_wall_visual'>
          <pose>0 2 1.25 0 0 0</pose>
          <geometry><box><size>8 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='south_wall'>
          <pose>0 -2 1.25 0 0 0</pose>
          <geometry><box><size>8 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='south_wall_visual'>
          <pose>0 -2 1.25 0 0 0</pose>
          <geometry><box><size>8 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='west_wall'>
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
        </collision>
        <visual name='west_wall_visual'>
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='east_wall'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
        </collision>
        <visual name='east_wall_visual'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='divider_lower'>
          <pose>0 -1.25 1.25 0 0 0</pose>
          <geometry><box><size>0.15 1.5 2.5</size></box></geometry>
        </collision>
        <visual name='divider_lower_visual'>
          <pose>0 -1.25 1.25 0 0 0</pose>
          <geometry><box><size>0.15 1.5 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='divider_upper'>
          <pose>0 1.25 1.25 0 0 0</pose>
          <geometry><box><size>0.15 1.5 2.5</size></box></geometry>
        </collision>
        <visual name='divider_upper_visual'>
          <pose>0 1.25 1.25 0 0 0</pose>
          <geometry><box><size>0.15 1.5 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
