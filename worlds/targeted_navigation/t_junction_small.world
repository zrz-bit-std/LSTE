<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='lste_t_junction_small'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.72 0.72 1</background>
      <shadows>true</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      A compact physical T topology.  The horizontal corridor is x=[-5,5],
      y=[-1.25,1.25].  The north wall has a two-metre opening x=[1,3],
      leading to a one-place branch y=[1.25,7].  The robot starts in the west
      arm; the east arm is a bounded dead end and the north arm is the only
      continuation.  No robot or semantic annotation is embedded here: all
      topology evidence must come from the lidar and odometry.
    -->
    <model name='t_junction_structure'>
      <static>true</static>
      <link name='walls'>
        <collision name='south_wall'>
          <pose>0 -1.25 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='south_wall_visual'>
          <pose>0 -1.25 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='north_wall_west'>
          <pose>-2 1.25 1.25 0 0 0</pose>
          <geometry><box><size>6 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='north_wall_west_visual'>
          <pose>-2 1.25 1.25 0 0 0</pose>
          <geometry><box><size>6 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='north_wall_east'>
          <pose>4 1.25 1.25 0 0 0</pose>
          <geometry><box><size>2 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='north_wall_east_visual'>
          <pose>4 1.25 1.25 0 0 0</pose>
          <geometry><box><size>2 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='west_end_wall'>
          <pose>-5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.5 2.5</size></box></geometry>
        </collision>
        <visual name='west_end_wall_visual'>
          <pose>-5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.5 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='east_end_wall'>
          <pose>5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.5 2.5</size></box></geometry>
        </collision>
        <visual name='east_end_wall_visual'>
          <pose>5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.5 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='branch_west_wall'>
          <pose>1 4.125 1.25 0 0 0</pose>
          <geometry><box><size>0.15 5.75 2.5</size></box></geometry>
        </collision>
        <visual name='branch_west_wall_visual'>
          <pose>1 4.125 1.25 0 0 0</pose>
          <geometry><box><size>0.15 5.75 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='branch_east_wall'>
          <pose>3 4.125 1.25 0 0 0</pose>
          <geometry><box><size>0.15 5.75 2.5</size></box></geometry>
        </collision>
        <visual name='branch_east_wall_visual'>
          <pose>3 4.125 1.25 0 0 0</pose>
          <geometry><box><size>0.15 5.75 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name='branch_end_wall'>
          <pose>2 7 1.25 0 0 0</pose>
          <geometry><box><size>2 0.15 2.5</size></box></geometry>
        </collision>
        <visual name='branch_end_wall_visual'>
          <pose>2 7 1.25 0 0 0</pose>
          <geometry><box><size>2 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
